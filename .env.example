# MediaStack MCP — example environment file
# Copy to .env and fill in real values. Only configured services are polled;
# leave a service's variables unset (or remove them) to skip it.

# -- Database (required) --
DB_MEDIASTACK_NAME=mediastack
DB_MEDIASTACK_USER=mediastack
DB_MEDIASTACK_PASS=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Or override the assembled URL entirely:
# MEDIASTACK_DB_URL=postgresql://mediastack:change_me@postgres:5432/mediastack

# -- Authentication (optional) --
# When set, requests to /mcp and /ingest must send
# "Authorization: Bearer <token>". /health stays open. Unset = no auth.
# Generate with: openssl rand -hex 32
# MEDIASTACK_AUTH_TOKEN=

# -- Polling intervals (seconds) --
MEDIASTACK_POLL_INTERVAL=300
MEDIASTACK_STORAGE_INTERVAL=3600
MEDIASTACK_LIBRARY_INTERVAL=21600
# Daily HH:MM schedule for library polling (container local time).
# Takes precedence over MEDIASTACK_LIBRARY_INTERVAL when set.
# MEDIASTACK_LIBRARY_CRON=02:30

# -- *arr services (URL + API key pairs) --
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=your_sonarr_api_key
RADARR_URL=http://radarr:7878
RADARR_API_KEY=your_radarr_api_key
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=your_lidarr_api_key
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=your_prowlarr_api_key
BAZARR_URL=http://bazarr:6767
BAZARR_API_KEY=your_bazarr_api_key

# -- Jellyfin --
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=your_jellyfin_api_key
# Pin the Jellyfin user used for favourites/watched defaults (optional)
# JELLYFIN_USER_ID=

# -- Seerr (Overseerr/Jellyseerr) --
SEERR_URL=http://seerr:5055
SEERR_API_KEY=your_seerr_api_key

# -- Audiobookshelf --
AUDIOBOOKSHELF_URL=http://audiobookshelf:80
AUDIOBOOKSHELF_API_KEY=your_audiobookshelf_api_key

# -- Download clients --
SABNZBD_URL=http://sabnzbd:8080
SABNZBD_API_KEY=your_sabnzbd_api_key
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=change_me

# -- Dispatcharr (JWT auth) --
DISPATCHARR_URL=http://dispatcharr:9191
DISPATCHARR_USERNAME=admin
DISPATCHARR_PASSWORD=change_me

# -- Boxarr (no auth) --
BOXARR_URL=http://boxarr:8888

# -- Suggestarr (JWT auth) --
SUGGESTARR_URL=http://suggestarr:5000
SUGGESTARR_USERNAME=admin
SUGGESTARR_PASSWORD=change_me

# -- Filesystem scanning (orphan/ghost detection, off by default) --
FILESYSTEM_SCAN_ENABLED=false
MEDIA_ROOTS=/media
# Container path -> Jellyfin path pairs, comma-separated
# MEDIA_PATH_MAPPINGS=/media/Movies:/data/Movies,/media/Series:/data/TV
GHOST_HISTORY_LIMIT=500

# -- Prowlarr category overrides (Newznab IDs, comma-separated) --
# PROWLARR_CATEGORIES_MOVIE=2000
# PROWLARR_CATEGORIES_TV=5000
# PROWLARR_CATEGORIES_MUSIC=3000
# PROWLARR_CATEGORIES_BOOK=7000,8000
